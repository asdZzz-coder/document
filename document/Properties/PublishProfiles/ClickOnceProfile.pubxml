<?xml version="1.0" encoding="utf-8"?>
<!--
  ClickOnce 發佈設定。
  - 編譯仍是一般的 .NET（自帶執行環境 self-contained，對方電腦不用另外裝 .NET）。
  - 只用 ClickOnce 產生安裝檔（DocumentKeeper.application + Application Files），
    發佈時再加上 installer\安裝.cmd：先複製到固定資料夾再安裝，避免「已從其他位置安裝」的錯誤。
  - 關閉 ClickOnce 內建更新：檢查更新一律由程式向 GitHub Release 下載（見 UpdateService）。
  發佈：msbuild document.csproj /t:Publish /p:PublishProfile=ClickOnceProfile /p:Version=1.2.3 /p:ApplicationVersion=1.2.3.0
  （ClickOnce 的 manifest 需要 .NET Framework 版的 MSBuild，也就是 Visual Studio / Build Tools 的 msbuild，GitHub Actions 上已內建）
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>

    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishDir>bin\clickonce\</PublishDir>
    <PublishUrl>bin\clickonce\</PublishUrl>
    <GenerateManifests>true</GenerateManifests>
    <SignManifests>false</SignManifests>

    <!-- 安裝到電腦（開始功能表 + 桌面捷徑），從安裝包所在的資料夾安裝 -->
    <Install>true</Install>
    <InstallFrom>Disk</InstallFrom>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <ProductName>文件整理</ProductName>
    <PublisherName>asdZzz-coder</PublisherName>
    <SuiteName>文件整理</SuiteName>

    <!-- 不使用 ClickOnce 內建更新 -->
    <UpdateEnabled>false</UpdateEnabled>

    <!-- 版本由建置參數 /p:ApplicationVersion 帶入；ApplicationRevision 固定 0，避免每次發佈自動加一 -->
    <ApplicationVersion>1.0.0.0</ApplicationVersion>
    <ApplicationRevision>0</ApplicationRevision>
    <IsRevisionIncremented>false</IsRevisionIncremented>

    <!-- 不產生 setup.exe：自帶執行環境、沒有必要元件，改由 安裝.cmd 開啟 DocumentKeeper.application -->
    <BootstrapperEnabled>false</BootstrapperEnabled>
  </PropertyGroup>
</Project>
