<Window x:Class="document.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True">
    <!-- 輸入一行文字的小對話框（新增資料夾、重新命名） -->
    <StackPanel Margin="22,18,22,20">
        <TextBlock x:Name="PromptText" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="InputBox" TextChanged="InputBox_TextChanged"/>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,6,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" IsCancel="True" MinWidth="88" Margin="0,0,8,0"
                    Content="取消"/>
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="88"
                    Content="確定" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
