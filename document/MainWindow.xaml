<Window x:Class="document.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件整理" Height="840" Width="1280" MinHeight="600" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        Loaded="Window_Loaded" Closed="Window_Closed" Activated="Window_Activated">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 卡片：白底、細框、大圓角；陰影放在另一層（見 CardShadow），避免內文被模糊 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CardShadow" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="4" Direction="270" Opacity="0.07" Color="#1E1B4B"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 輸入框上的灰色提示文字：輸入框為空時才顯示 -->
        <Style x:Key="Placeholder" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- 資料夾前面的展開 / 收合箭頭 -->
        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource FieldIconButton}">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        </Style>

        <!-- 右側資訊的一列：灰色小標題 + 內容 -->
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- 文件清單的一列：類型圖示 + 名稱 / 類型、大小、日期 + 所在資料夾標籤 -->
        <DataTemplate x:Key="FileTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Background="{Binding TileBrush}">
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="18" Foreground="White"
                               HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
                <!-- 全部文件 / 搜尋結果：顯示在哪個資料夾 -->
                <Border Grid.Column="2" CornerRadius="8" Padding="8,3" VerticalAlignment="Center" MaxWidth="220"
                        Background="{DynamicResource AccentSoftBrush}" ToolTip="{Binding FolderText}"
                        Visibility="{Binding HasFolderText, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,1,5,0"/>
                        <TextBlock Text="{Binding FolderText}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="28,22,28,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 標題列 ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <!-- 工具列：一條白色膠囊裡放幾個透明按鈕 -->
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <!-- 主題：按一下依序切換 跟隨系統 → 淺色 → 深色（圖示與提示文字由程式設定） -->
                    <Button x:Name="ThemeButton" Style="{StaticResource GhostButton}" Padding="10,8" Click="Theme_Click">
                        <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE770;"/>
                    </Button>
                    <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                    <Button Style="{StaticResource GhostButton}" ToolTip="變更資料夾和文件存放在電腦上的位置" Click="ChangeRoot_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8DA;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="存放位置"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                    <Button Style="{StaticResource GhostButton}" ToolTip="在桌面建立（或修復）捷徑" Click="Shortcut_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="桌面捷徑"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Click="CheckUpdate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,8,0"/>
                            <TextBlock Text="檢查更新"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource AccentGradient}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.25" Color="#4F46E5"/>
                </Border.Effect>
                <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="21" Foreground="White"
                           HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="文件整理" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="CountText" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="1,1,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- ===== 主內容 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- 最左：資料夾樹（全部文件 / 資料夾 › 子資料夾…）+ 存放位置 -->
            <Border Grid.Column="0" Style="{StaticResource CardShadow}"/>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,16,12,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="6,0,0,10">
                        <Button x:Name="NewFolderButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="9,5" FontSize="12"
                                Foreground="{DynamicResource AccentBrush}" ToolTip="在目前選的資料夾裡新增資料夾" Click="NewFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="新增資料夾" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="資料夾" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ListBox x:Name="FolderList" Grid.Row="1" Style="{StaticResource FolderListStyle}" SelectionMode="Single"
                             AllowDrop="True"
                             SelectionChanged="FolderList_SelectionChanged" MouseDoubleClick="FolderList_MouseDoubleClick"
                             ContextMenuOpening="FolderList_ContextMenuOpening"
                             PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="FolderList_PreviewMouseMove"
                             DragOver="FolderList_DragOver" DragLeave="FolderList_DragLeave" Drop="FolderList_Drop">
                        <ListBox.ContextMenu>
                            <ContextMenu/>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- 拖曳經過時的強調框 -->
                                    <Border x:Name="DropFrame" Margin="-8,-3,-4,-3" CornerRadius="10" BorderThickness="1.5"
                                            BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource AccentSoftBrush}"
                                            Visibility="{Binding IsDropTarget, Converter={StaticResource BoolToVis}}"/>
                                    <Grid Margin="{Binding Indent}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- 箭頭：有子資料夾才顯示；沒有時保留空位，名稱才會對齊 -->
                                        <Grid Width="22" Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}">
                                            <Button Content="{Binding Arrow}" Style="{StaticResource ArrowButton}" Click="Toggle_Click"
                                                    ToolTip="展開 / 收合"
                                                    Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" Margin="2,0,9,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip="{Binding Tooltip}"/>
                                        <!-- 數量：圓角小標籤 -->
                                        <Border x:Name="CountLabel" Grid.Column="3" CornerRadius="999" Padding="8,1" Margin="8,0,2,0" MinWidth="26"
                                                VerticalAlignment="Center" Background="{DynamicResource HoverBrush}">
                                            <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource MutedBrush}"/>
                                        </Border>
                                        <!-- 滑過資料夾時，數字換成「新增子資料夾 / 重新命名 / 刪除」按鈕 -->
                                        <StackPanel x:Name="Actions" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed" Margin="4,0,0,0">
                                            <Button Content="&#xE710;" Style="{StaticResource FieldIconButton}" Width="26" Height="26" FontSize="11"
                                                    ToolTip="在這裡新增子資料夾" Click="AddChild_Click"/>
                                            <Button Content="&#xE70F;" Style="{StaticResource FieldIconButton}" Width="26" Height="26" FontSize="12"
                                                    ToolTip="重新命名" Click="RenameFolder_Click"/>
                                            <Button Content="&#xE74D;" Style="{StaticResource IconButton}" FontSize="12"
                                                    ToolTip="刪除（丟到資源回收筒）" Click="DeleteFolder_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="CountLabel" Property="Background" Value="{DynamicResource CardBrush}"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                            <Condition Binding="{Binding IsFolder}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Actions" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="CountLabel" Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 存放位置：目前的資料夾路徑 + 變更 / 開啟 -->
                    <Border Grid.Row="2" CornerRadius="12" Padding="12,10,8,10" Margin="0,10,0,0" Background="{DynamicResource InputBgBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8DA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                               Margin="0,1,6,0"/>
                                    <TextBlock Text="存放位置" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock x:Name="RootPathText" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                <Button Content="&#xE70F;" Style="{StaticResource FieldIconButton}" ToolTip="變更存放位置"
                                        Click="ChangeRoot_Click"/>
                                <Button Content="&#xE8A7;" Style="{StaticResource FieldIconButton}" ToolTip="在檔案總管開啟"
                                        Click="OpenRoot_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 中：搜尋 + 排序 + 文件清單（可以把檔案拖進來） -->
            <Border Grid.Column="2" Style="{StaticResource CardShadow}"/>
            <Border x:Name="FileCard" Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="SearchBox" Padding="38,9,12,9" TextChanged="SearchBox_TextChanged"/>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource SubtleBrush}"
                                       Margin="14,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="搜尋檔名（包含子資料夾）…" Margin="40,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Placeholder}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ComboBox x:Name="SortBox" Grid.Column="1" Width="150" Margin="10,0,0,0" ToolTip="排序方式"
                                  SelectionChanged="SortBox_SelectionChanged">
                            <ComboBoxItem Content="依名稱"/>
                            <ComboBoxItem Content="依修改日期（新到舊）"/>
                            <ComboBoxItem Content="依大小（大到小）"/>
                            <ComboBoxItem Content="依類型"/>
                        </ComboBox>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="14,9"
                                ToolTip="選擇檔案，複製到目前的資料夾" Click="AddFiles_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                <TextBlock Text="加入文件"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 目前位置：資料夾路徑 + 數量 + 在檔案總管開啟 -->
                    <DockPanel Grid.Row="1" Margin="2,0,0,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="9,5" FontSize="12"
                                ToolTip="在檔案總管開啟目前的資料夾" Click="OpenCurrentFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="在檔案總管開啟"/>
                            </StackPanel>
                        </Button>
                        <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run x:Name="LocationText" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"/>
                            <Run x:Name="ListCountText" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
                        </TextBlock>
                    </DockPanel>

                    <ListBox x:Name="FileList" Grid.Row="2" Style="{StaticResource EntryListStyle}"
                             ItemTemplate="{StaticResource FileTemplate}" SelectionMode="Extended" AllowDrop="True"
                             SelectionChanged="FileList_SelectionChanged" MouseDoubleClick="FileList_MouseDoubleClick"
                             KeyDown="FileList_KeyDown" ContextMenuOpening="FileList_ContextMenuOpening"
                             PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="FileList_PreviewMouseMove"
                             DragEnter="FileList_DragOver" DragOver="FileList_DragOver" DragLeave="FileList_DragLeave" Drop="FileList_Drop">
                        <ListBox.ContextMenu>
                            <ContextMenu/>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <!-- 空清單提示 -->
                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentSoftBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock x:Name="EmptyIcon" Text="&#xE898;" Style="{StaticResource Icon}" FontSize="26"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="EmptyText" TextAlignment="Center" LineHeight="20"
                                   Foreground="{DynamicResource MutedBrush}"/>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=FileList}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>

                    <!-- 從檔案總管拖檔案進來時的提示框 -->
                    <Border x:Name="DropHint" Grid.Row="2" CornerRadius="14" BorderThickness="2" Visibility="Collapsed"
                            BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource AccentSoftBrush}"
                            Opacity="0.94" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="30" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="DropHintText" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右：選取項目的資訊與操作 -->
            <Border Grid.Column="4" Style="{StaticResource CardShadow}"/>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="20,20,20,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="15"
                                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="文件資訊" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- 沒有選取時：使用說明 -->
                    <StackPanel x:Name="NoSelectionPanel" Grid.Row="1" Grid.RowSpan="2">
                        <TextBlock Text="在中間的清單選一份文件，這裡會顯示它的資訊。" TextWrapping="Wrap" FontSize="13"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,18"/>
                        <Border CornerRadius="12" Padding="14,12" Background="{DynamicResource InputBgBrush}">
                            <StackPanel>
                                <TextBlock Text="小技巧" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8"/>
                                <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource MutedBrush}">
                                    • 從檔案總管把檔案拖進中間的清單，就會複製到目前的資料夾。<LineBreak/>
                                    • 把文件拖到左邊的資料夾，就會搬過去；資料夾也可以拖進別的資料夾。<LineBreak/>
                                    • 滑過資料夾可以新增子資料夾、改名或刪除；按右鍵也可以。<LineBreak/>
                                    • 雙擊文件開啟；按 F2 改名，按 Delete 刪除（會丟到資源回收筒）。
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 選了一份文件或一個資料夾 -->
                    <ScrollViewer x:Name="DetailPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="0,0,8,0">
                            <Border x:Name="DetailTile" Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Left" Margin="0,0,0,14">
                                <TextBlock x:Name="DetailGlyph" Style="{StaticResource Icon}" FontSize="28" Foreground="White"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="DetailName" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <Border HorizontalAlignment="Left" CornerRadius="6" Padding="8,2" Margin="0,0,0,18"
                                    Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock x:Name="DetailType" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>

                            <TextBlock Text="位置" Style="{StaticResource InfoLabel}"/>
                            <TextBlock x:Name="DetailFolder" Style="{StaticResource InfoValue}"/>
                            <TextBlock x:Name="DetailSizeLabel" Text="大小" Style="{StaticResource InfoLabel}"/>
                            <TextBlock x:Name="DetailSize" Style="{StaticResource InfoValue}"/>
                            <TextBlock Text="修改日期" Style="{StaticResource InfoLabel}"/>
                            <TextBlock x:Name="DetailModified" Style="{StaticResource InfoValue}"/>
                            <TextBlock Text="建立日期" Style="{StaticResource InfoLabel}"/>
                            <TextBlock x:Name="DetailCreated" Style="{StaticResource InfoValue}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 選了好幾個 -->
                    <StackPanel x:Name="MultiPanel" Grid.Row="1" Visibility="Collapsed">
                        <Border Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Left" Margin="0,0,0,14"
                                Background="{DynamicResource AccentGradient}">
                            <TextBlock Text="&#xE8B3;" Style="{StaticResource Icon}" FontSize="28" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="MultiText" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="MultiSizeText" FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>

                    <!-- 操作按鈕固定在卡片底部 -->
                    <StackPanel x:Name="ActionPanel" Grid.Row="2" Margin="0,16,0,0" Visibility="Collapsed">
                        <Button x:Name="OpenButton" Style="{StaticResource PrimaryButton}" Padding="10,10" Margin="0,0,0,8" Click="Open_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock x:Name="OpenButtonText" Text="開啟"/>
                            </StackPanel>
                        </Button>
                        <UniformGrid Columns="2" Rows="2">
                            <Button x:Name="RevealButton" Margin="0,0,4,8" Padding="8,9" Click="Reveal_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="在檔案總管顯示"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RenameButton" Margin="4,0,0,8" Padding="8,9" Click="Rename_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="重新命名"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="MoveButton" Margin="0,0,4,0" Padding="8,9" Click="Move_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8DE;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="移到…"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu/>
                                </Button.ContextMenu>
                            </Button>
                            <Button Style="{StaticResource DangerButton}" Margin="4,0,0,0" Padding="8,9" Click="Delete_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="刪除"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 頁尾 ===== -->
        <DockPanel Grid.Row="2" Margin="4,12,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
